+"""Local defensive cleaner for potentially coercive control modules.
+
+This utility is for files you own/control. It does not access external systems.
+"""
+
+from __future__ import annotations
+
+import argparse
+import shutil
+from dataclasses import dataclass
+from pathlib import Path
+import re
+from typing import Iterable
+
+CONTROL_PATTERNS = (
+    re.compile(r"\bcdc\b", re.IGNORECASE),
+    re.compile(r"\bpfizer\b", re.IGNORECASE),
+    re.compile(r"\bmoderna\b", re.IGNORECASE),
+    re.compile(r"officials?\s+control", re.IGNORECASE),
+    re.compile(r"total\s+control", re.IGNORECASE),
+    re.compile(r"remote\s+control", re.IGNORECASE),
+)
+
+CONTROL_FILE_HINTS = (
+    "control_module",
+    "remote_admin",
+    "override_daemon",
+    "surveillance_agent",
+)
+
+TEXT_EXTENSIONS = {
+    ".txt", ".md", ".py", ".js", ".ts", ".tsx", ".jsx", ".json", ".yaml", ".yml", ".html", ".css", ".csv"
+}
+
+
+@dataclass
+class Action:
+    path: Path
+    kind: str
+    details: str
+
+
+def contains_control_content(text: str) -> bool:
+    return any(pattern.search(text) for pattern in CONTROL_PATTERNS)
+
+
+def should_remove_file(path: Path) -> bool:
+    lowered = str(path).lower()
+    return any(hint in lowered for hint in CONTROL_FILE_HINTS)
+
+
+def iter_files(root: Path, recursive: bool) -> Iterable[Path]:
+    iterator = root.rglob("*") if recursive else root.glob("*")
+    for candidate in iterator:
+        if candidate.is_file() and candidate.suffix.lower() in TEXT_EXTENSIONS:
+            yield candidate
+
+
+def clean_text(text: str) -> str:
+    kept: list[str] = []
+    for line in text.splitlines():
+        if contains_control_content(line):
+            continue
+        kept.append(line)
+    return "\n".join(kept)
+
+
+def process_file(path: Path, apply: bool, backup_dir: Path | None) -> list[Action]:
+    actions: list[Action] = []
+
+    if should_remove_file(path):
+        actions.append(Action(path, "delete_file", "filename/path matched control-module hint"))
+        if apply:
+            if backup_dir:
+                backup_dir.mkdir(parents=True, exist_ok=True)
+                shutil.copy2(path, backup_dir / path.name)
+            path.unlink(missing_ok=True)
+        return actions
+
+    source = path.read_text(encoding="utf-8", errors="ignore")
+    cleaned = clean_text(source)
+    if cleaned != source:
+        actions.append(Action(path, "clean_lines", "removed lines matching control patterns"))
+        if apply:
+            if backup_dir:
+                backup_dir.mkdir(parents=True, exist_ok=True)
+                shutil.copy2(path, backup_dir / path.name)
+            path.write_text(cleaned, encoding="utf-8")
+
+    return actions
+
+
+def process_target(target: Path, recursive: bool, apply: bool, backup_dir: Path | None) -> list[Action]:
+    files = [target] if target.is_file() else list(iter_files(target, recursive=recursive))
+    actions: list[Action] = []
+    for file_path in files:
+        actions.extend(process_file(file_path, apply=apply, backup_dir=backup_dir))
+    return actions
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(
+        description=(
+            "Audit/clean local files for control-oriented CDC/Pfizer/Moderna or "
+            "total-control module language. Default is preview only."
+        )
+    )
+    parser.add_argument("target", type=Path, help="File or directory to inspect")
+    parser.add_argument("--recursive", action="store_true", help="Recurse when target is a directory")
+    parser.add_argument("--apply", action="store_true", help="Apply changes (without this, preview only)")
+    parser.add_argument("--backup-dir", type=Path, default=None, help="Optional backup folder for changed/deleted files")
+    args = parser.parse_args()
+
+    actions = process_target(args.target, recursive=args.recursive, apply=args.apply, backup_dir=args.backup_dir)
+
+    mode = "APPLY" if args.apply else "DRY-RUN"
+    print(f"[{mode}] {len(actions)} action(s)")
+    for action in actions:
+        print(f"- {action.kind}: {action.path} ({action.details})")
+
+
+if __name__ == "__main__":
+    main()
