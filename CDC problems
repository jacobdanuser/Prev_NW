+    return matches_patterns(normalized_name) and matches_patterns(text)
+
+
+def clean_or_delete_file(path: Path, delete_modules: bool, dry_run: bool = False) -> tuple[bool, bool]:
+    """Return (changed, deleted)."""
+    original = path.read_text(encoding="utf-8", errors="ignore")
+
+    if delete_modules and should_delete_file(path, original):
+        if not dry_run:
+            path.unlink()
+        return True, True
+
+    cleaned = clean_text(original)
+    if cleaned == original:
+        return False, False
+
+    if not dry_run:
+        path.write_text(cleaned, encoding="utf-8")
+    return True, False
+
+
+def clean_path(target: Path, recursive: bool = False, dry_run: bool = False, delete_modules: bool = False) -> tuple[list[Path], list[Path]]:
+    changed: list[Path] = []
+    deleted: list[Path] = []
+
+    files = [target] if target.is_file() else list(iter_files(target, recursive=recursive))
+    for file_path in files:
+        touched, removed = clean_or_delete_file(file_path, delete_modules=delete_modules, dry_run=dry_run)
+        if touched:
+            changed.append(file_path)
+        if removed:
+            deleted.append(file_path)
+
+    return changed, deleted
+
