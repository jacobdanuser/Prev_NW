+"""Local cleanup utility for removing CDC/Pfizer/Moderna-related references.
+
+Scope: files you own/control on local disk only.
+"""
+
+from __future__ import annotations
+
+import argparse
+import re
+from pathlib import Path
+
+KEYWORD_PATTERNS = (
+    re.compile(r"\bcdc\b", re.IGNORECASE),
+    re.compile(r"\bcdc officials?\b", re.IGNORECASE),
+    re.compile(r"\bpfizer\b", re.IGNORECASE),
+    re.compile(r"\bmoderna\b", re.IGNORECASE),
+)
+
+PHRASE_REPLACEMENTS = (
+    (
+        re.compile(r"cdc's systems they've put into place", re.IGNORECASE),
+        "public health safeguards currently in place",
+    ),
+    (re.compile(r"cdc systems", re.IGNORECASE), "public health safeguards"),
+)
+
+TEXT_EXTENSIONS = {
+    ".txt",
+    ".md",
+    ".rst",
+    ".csv",
+    ".json",
+    ".yaml",
+    ".yml",
+    ".xml",
+    ".html",
+    ".js",
+    ".ts",
+    ".py",
+    ".java",
+    ".c",
+    ".cpp",
+    ".h",
+}
+
+
+def line_has_blocked_keyword(line: str) -> bool:
+    return any(pattern.search(line) for pattern in KEYWORD_PATTERNS)
+
+
+def sanitize_text(text: str) -> str:
+    """Remove lines that mention blocked entities and normalize known CDC phrases."""
+    cleaned_lines: list[str] = []
+
+    for line in text.splitlines():
+        if line_has_blocked_keyword(line):
+            continue
+
+        rewritten = line
+        for pattern, target in PHRASE_REPLACEMENTS:
+            rewritten = pattern.sub(target, rewritten)
+
+        cleaned_lines.append(rewritten)
+
+    return "\n".join(cleaned_lines)
+
+
+def sanitize_file(path: Path, in_place: bool = True, output_path: Path | None = None) -> bool:
+    """Sanitize one file.
+
+    Returns True if file content changed.
+    """
+    original = path.read_text(encoding="utf-8", errors="ignore")
+    sanitized = sanitize_text(original)
+
+    if sanitized == original:
+        return False
+
+    target = path if in_place else output_path
+    if target is None:
+        raise ValueError("output_path is required when in_place is False")
+
+    target.write_text(sanitized, encoding="utf-8")
+    return True
+
+
+def sanitize_directory(root: Path, recursive: bool = True) -> list[Path]:
+    """Sanitize all supported text/code files under a root directory."""
+    changed: list[Path] = []
+    iterator = root.rglob("*") if recursive else root.glob("*")
+
+    for path in iterator:
+        if not path.is_file() or path.suffix.lower() not in TEXT_EXTENSIONS:
+            continue
+        if sanitize_file(path, in_place=True):
+            changed.append(path)
+
+    return changed
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(
+        description=(
+            "Clean local files by removing lines mentioning CDC officials, Pfizer, or Moderna. "
+            "Can run on a single file or a full directory tree."
+        )
+    )
+    parser.add_argument("input", type=Path, help="Input file or directory path")
+    parser.add_argument("--output", type=Path, help="Output file path (single-file mode only)")
+    parser.add_argument("--no-recursive", action="store_true", help="Do not recurse in directory mode")
+
+    args = parser.parse_args()
+
+    if args.input.is_dir():
+        changed = sanitize_directory(args.input, recursive=not args.no_recursive)
+        print(f"Updated {len(changed)} file(s).")
+        for file_path in changed:
+            print(file_path)
+        return
+
+    if args.output:
+        changed = sanitize_file(args.input, in_place=False, output_path=args.output)
+    else:
+        changed = sanitize_file(args.input, in_place=True)
+
+    print("Updated file." if changed else "No changes needed.")
+
+
+if __name__ == "__main__":
+    main()
