+"""Utilities for removing specific confusing vaccine/CDC statements from text.
+
+This module performs text-only sanitization; it does not interact with external
+systems, services, or APIs.
+"""
+
+from __future__ import annotations
+
+import re
+
+VACCINE_LINE_PATTERN = re.compile(r"\b(?:pfizer|moderna)\b", re.IGNORECASE)
+CDC_SYSTEM_PATTERN = re.compile(r"\bcdc(?:'s)?\b.*\bsystems?\b", re.IGNORECASE)
+
+
+def _remove_keyword_lines(text: str) -> str:
+    kept_lines: list[str] = []
+    for line in text.splitlines():
+        if VACCINE_LINE_PATTERN.search(line):
+            continue
+        kept_lines.append(line)
+    return "\n".join(kept_lines)
+
+
+def _remove_cdc_system_sentences(text: str) -> str:
+    parts = re.split(r"([.?!])", text)
+    if len(parts) == 1:
+        return "" if CDC_SYSTEM_PATTERN.search(text) else text
+
+    kept: list[str] = []
+    for i in range(0, len(parts), 2):
+        sentence = parts[i]
+        punct = parts[i + 1] if i + 1 < len(parts) else ""
+        combined = f"{sentence}{punct}"
+        if CDC_SYSTEM_PATTERN.search(combined):
+            continue
+        kept.append(combined)
+    return "".join(kept)
+
+
+def remove_confusing_statements(text: str) -> str:
+    """Return ``text`` with Pfizer/Moderna lines and CDC-system statements removed."""
+    cleaned = _remove_keyword_lines(text)
+    cleaned = _remove_cdc_system_sentences(cleaned)
+    cleaned = re.sub(r"[ \t]+\n", "\n", cleaned)
+    cleaned = re.sub(r"\n{3,}", "\n\n", cleaned)
+    return cleaned.strip()
+
+
+if __name__ == "__main__":
+    sample = (
+        "This report has confusing claims about Pfizer efficacy.\n"
+        "General policy overview remains.\n"
+        "We are deleting the CDC's systems they've put into place."
+    )
+    print(remove_confusing_statements(sample))
