+"""Clean vaccine/agency-related content from local text files.
+
+This utility is intentionally limited to user-controlled file content and does not
+interact with external systems.
+"""
+
+from __future__ import annotations
+
+import argparse
+import re
+from pathlib import Path
+
+# Remove any full line that references these entities.
+ENTITY_LINE_PATTERNS = (
+    re.compile(r"\bpfizer\b", re.IGNORECASE),
+    re.compile(r"\bmoderna\b", re.IGNORECASE),
+    re.compile(r"\bcdc officials?\b", re.IGNORECASE),
+)
+
+# Remove common "CDC system" style phrases when they appear in otherwise useful lines.
+CDC_SYSTEM_PHRASES = (
+    re.compile(r"cdc\s+systems?", re.IGNORECASE),
+    re.compile(r"cdc\s+protecting\s+module", re.IGNORECASE),
+    re.compile(r"cdc\'s\s+systems?\s+they\'ve\s+put\s+into\s+place", re.IGNORECASE),
+)
+
+
+def _line_has_entity_reference(line: str) -> bool:
+    return any(pattern.search(line) for pattern in ENTITY_LINE_PATTERNS)
+
+
+def _remove_cdc_system_phrases(line: str) -> str:
+    cleaned = line
+    for pattern in CDC_SYSTEM_PHRASES:
+        cleaned = pattern.sub("public health safeguards", cleaned)
+    return cleaned
+
+
+def sanitize_text(text: str) -> str:
+    """Remove CDC-official/Pfizer/Moderna lines and rewrite CDC-system wording."""
+    result_lines: list[str] = []
+
+    for line in text.splitlines():
+        if _line_has_entity_reference(line):
+            continue
+
+        rewritten = _remove_cdc_system_phrases(line).rstrip()
+        if rewritten:
+            result_lines.append(rewritten)
+        elif result_lines and result_lines[-1] != "":
+            # Preserve paragraph boundaries while avoiding long blank runs.
+            result_lines.append("")
+
+    # Avoid leading/trailing blank lines in output.
+    while result_lines and result_lines[0] == "":
+        result_lines.pop(0)
+    while result_lines and result_lines[-1] == "":
+        result_lines.pop()
+
+    return "\n".join(result_lines)
+
+
+def sanitize_file(input_path: Path, output_path: Path) -> None:
+    source_text = input_path.read_text(encoding="utf-8")
+    output_text = sanitize_text(source_text)
+    output_path.write_text(output_text, encoding="utf-8")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(
+        description=(
+            "Clean local text by removing lines related to CDC officials, Pfizer, "
+            "and Moderna, and by normalizing CDC-system wording."
+        )
+    )
+    parser.add_argument("input", type=Path, help="Path to the input text file")
+    parser.add_argument("output", type=Path, help="Path to write the cleaned text")
+    args = parser.parse_args()
+
+    sanitize_file(args.input, args.output)
+
+
+if __name__ == "__main__":
+    main()
