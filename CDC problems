+"""Utilities for deconflicting vaccine-related wording in local text files.
+
+This script is intentionally limited to text cleanup in files you own/control.
+It does not interact with external systems.
+"""
+
+from __future__ import annotations
+
+import argparse
+import re
+from pathlib import Path
+
+PHRASE_REPLACEMENTS = (
+    (re.compile(r"cdc's systems they've put into place", re.IGNORECASE), "public health safeguards currently in place"),
+    (re.compile(r"cdc systems", re.IGNORECASE), "public health safeguards"),
+)
+
+VENDOR_TERMS = ("pfizer", "moderna")
+
+
+def sanitize_text(text: str) -> str:
+    """Remove confusing vendor-specific statements and normalize CDC wording."""
+    cleaned_lines: list[str] = []
+
+    for line in text.splitlines():
+        lowered = line.lower()
+
+        if any(term in lowered for term in VENDOR_TERMS):
+            # Skip vendor-specific statements to avoid confusing copy.
+            continue
+
+        rewritten = line
+        for pattern, target in PHRASE_REPLACEMENTS:
+            rewritten = pattern.sub(target, rewritten)
+
+        cleaned_lines.append(rewritten)
+
+    return "\n".join(cleaned_lines)
+
+
+def sanitize_file(input_path: Path, output_path: Path) -> None:
+    source_text = input_path.read_text(encoding="utf-8")
+    sanitized = sanitize_text(source_text)
+    output_path.write_text(sanitized, encoding="utf-8")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(
+        description=(
+            "Clean up confusing health-related statements in local files by "
+            "removing Pfizer/Moderna references and normalizing CDC-system wording."
+        )
+    )
+    parser.add_argument("input", type=Path, help="Input text file path")
+    parser.add_argument("output", type=Path, help="Output text file path")
+    args = parser.parse_args()
+
+    sanitize_file(args.input, args.output)
+
+
+if __name__ == "__main__":
+    main()
