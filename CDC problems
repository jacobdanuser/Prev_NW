+"""Local project cleaner for CDC/Pfizer/Moderna-related content.
+
+This tool only edits/removes files inside a path you explicitly provide.
+It does not access or alter external systems.
+"""
+
+from __future__ import annotations
+
+import argparse
+import re
+from pathlib import Path
+
+DEFAULT_TERMS = ("cdc", "pfizer", "moderna", "cdc officials")
+TEXT_EXTENSIONS = {".txt", ".md", ".rst", ".csv", ".json", ".yaml", ".yml", ".py", ".js", ".ts", ".html", ".css"}
+
+
+def contains_target_term(value: str, terms: tuple[str, ...]) -> bool:
+    lowered = value.lower()
+    return any(term in lowered for term in terms)
+
+
+def sanitize_text(text: str, terms: tuple[str, ...]) -> str:
+    cleaned_lines: list[str] = []
+    for line in text.splitlines():
+        if contains_target_term(line, terms):
+            continue
+        cleaned_lines.append(line)
+    return "\n".join(cleaned_lines)
+
+
+def iter_project_files(root: Path) -> list[Path]:
+    return [
+        path
+        for path in root.rglob("*")
+        if path.is_file() and ".git" not in path.parts and path.suffix.lower() in TEXT_EXTENSIONS
+    ]
+
+
+def clean_project(root: Path, terms: tuple[str, ...], dry_run: bool) -> tuple[list[Path], list[Path]]:
+    removed_files: list[Path] = []
+    updated_files: list[Path] = []
+
+    for path in iter_project_files(root):
+        relative_name = str(path.relative_to(root))
+
+        if contains_target_term(relative_name, terms):
+            removed_files.append(path)
+            if not dry_run:
+                path.unlink(missing_ok=True)
+            continue
+
+        original = path.read_text(encoding="utf-8", errors="ignore")
+        sanitized = sanitize_text(original, terms)
+
+        if sanitized != original:
+            updated_files.append(path)
+            if not dry_run:
+                path.write_text(sanitized, encoding="utf-8")
+
+    return removed_files, updated_files
+
+
+def compile_terms(raw_terms: list[str] | None) -> tuple[str, ...]:
+    if not raw_terms:
+        return DEFAULT_TERMS
+
+    normalized: list[str] = []
+    for term in raw_terms:
+        normalized.extend(part.strip().lower() for part in re.split(r",", term) if part.strip())
+    return tuple(dict.fromkeys(normalized))
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(
+        description=(
+            "Clean a local project by removing CDC/Pfizer/Moderna-related file content "
+            "and deleting files whose names contain matching terms."
+        )
+    )
+    parser.add_argument("root", type=Path, help="Project root to clean")
+    parser.add_argument(
+        "--terms",
+        nargs="*",
+        help="Optional comma-separated or space-separated terms. Defaults to CDC/Pfizer/Moderna set.",
+    )
+    parser.add_argument("--dry-run", action="store_true", help="Show what would change without writing")
+    args = parser.parse_args()
+
+    root = args.root.resolve()
+    if not root.exists() or not root.is_dir():
+        raise SystemExit(f"Root path is not a directory: {root}")
+
+    terms = compile_terms(args.terms)
+    removed_files, updated_files = clean_project(root, terms, args.dry_run)
+
+    print(f"Terms: {', '.join(terms)}")
+    print(f"Removed files: {len(removed_files)}")
+    for file_path in removed_files:
+        print(f"  - {file_path}")
+
+    print(f"Updated files: {len(updated_files)}")
+    for file_path in updated_files:
+        print(f"  - {file_path}")
+
+
+if __name__ == "__main__":
+    main()
