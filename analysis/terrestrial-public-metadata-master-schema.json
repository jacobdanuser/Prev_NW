{
  "updated_at":"2026-07-29",
  "scope":"Public terrestrial environmental, geographic, ecological, geological, agricultural, infrastructure, and land-use metadata schema",
  "definition":"Terrestrial metadata describes land-based environments and processes, including soils, geology, ecosystems, vegetation, wildlife, agriculture, land cover/use, freshwater systems, hazards, and surface infrastructure.",
  "geospatial_core":["dataset/site identifier","latitude","longitude","elevation","vertical datum","coordinate reference system","geometry","spatial resolution","geographic extent","survey/observation date","temporal coverage","accuracy/uncertainty"],
  "physical_environment":["air temperature","precipitation","humidity","wind","solar radiation","soil temperature","soil moisture","snow/ice cover where applicable","surface-water presence","groundwater depth where public"],
  "geology_and_soils":["geologic unit","rock/lithology","mineral composition","soil classification","soil texture","organic carbon","pH","bulk density","erosion indicators","sediment properties","geologic age","fault/structural information","sampling method","laboratory method"],
  "ecosystems_and_biodiversity":["ecosystem/habitat type","land-cover class","vegetation type","species/taxon","observation date","abundance/count where public","distribution/range","invasive-species status","protected-area status","habitat condition","sampling/observation method","observation uncertainty"],
  "hydrology":["watershed/basin","river/stream identifier","flow/discharge","water level","lake/reservoir level","water temperature","water chemistry","groundwater observation","aquifer/geologic unit","flood extent","drought indicator","monitoring station","measurement timestamp","quality flag"],
  "agriculture_and_land_use":["land-use class","crop/production type","irrigation status","soil management","vegetation index","field/site identifier where publicly available","harvest/production period","agricultural statistics","rangeland condition","forest management class"],
  "terrain_and_remote_sensing":["digital elevation model","slope","aspect","terrain class","satellite/platform","sensor","acquisition time","spectral/product bands","processing level","cloud/quality mask","land-cover classification","change-detection product"],
  "hazards":["earthquake event","seismic magnitude","ground motion","volcanic activity","landslide","wildfire","flood","drought","extreme heat/cold","storm impact","hazard zone","event timestamp","severity","affected area","source/provenance"],
  "human_and_built_environment":["road/rail identifier","bridge/structure type","building/land-use aggregate","utility/infrastructure category","protected/public land","administrative boundary","cadastral/public parcel metadata where legally public","planning/zoning category","survey date","operator/owner where publicly documented"],
  "subsurface_interface":["depth","subsurface feature","groundwater","mine/quarry","cave","tunnel","soil/geology profile","survey method","survey date","public access status","accuracy/uncertainty"],
  "data_provenance":["publisher","creator","agency/institution","instrument/platform","collection method","processing method","dataset version","publication/update date","source URL","license","citation","quality-control status","related dataset","archival/provenance record"],
  "recommended_public_source_families":["national mapping agencies","national geological surveys","national statistical offices","environmental agencies","meteorological services","agricultural agencies","protected-area authorities","national archives","NASA Earthdata","USGS","NOAA","FAO","GBIF","UNEP","Copernicus Land Monitoring Service","ISRIC SoilGrids","GEBCO/other elevation or terrain repositories where applicable"],
  "schema_validation":["Preserve original coordinate reference systems and units","Keep measured observations separate from modeled/derived products","Record vertical datum for elevation/depth","Distinguish land cover from land use","Distinguish species observations from inferred range maps","Record uncertainty and quality flags","Preserve original-language names separately from translations/transliterations","Record source and retrieval/publication date","Respect licensing, access controls, and sensitive-location restrictions"],
  "privacy_security_boundary":["No private landowner dossiers","No private addresses/contact information","No private individual location tracking","No credentials","No restricted government data","No protected archaeological or ecological locations where disclosure is restricted","No proprietary sensor firmware/source code","No unauthorized telemetry"],
  "status":"Master public-source schema for terrestrial datasets; it is not an exhaustive extraction of every terrestrial dataset worldwide."
}
